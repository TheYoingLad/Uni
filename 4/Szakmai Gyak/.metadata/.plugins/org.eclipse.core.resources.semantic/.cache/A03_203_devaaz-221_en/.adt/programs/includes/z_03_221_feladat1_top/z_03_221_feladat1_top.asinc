*&----------------------------------------------------------------*
*& Include Z_03_221_FELADAT1_TOP - Module Pool      Z_03_221_FELADAT1
*&----------------------------------------------------------------*
PROGRAM z_03_221_feladat1.

TABLES: erpsls_billdoc, vbrk, adrc, t001.

DATA: ok_code     LIKE sy-ucomm,
      it_data     TYPE TABLE OF z03221_feladat1_data,
      gv_open     TYPE c LENGTH 1 VALUE 'X',
      gv_not_open TYPE c LENGTH 1,
      svbeln_low  TYPE erpsls_billdoc-vbeln,
      svbeln_high TYPE erpsls_billdoc-vbeln,
      sfkart_low  TYPE erpsls_billdoc-fkart,
      sfkart_high TYPE erpsls_billdoc-fkart,
      sfkdat_low  TYPE erpsls_billdoc-fkdat,
      sfkdat_high TYPE erpsls_billdoc-fkdat,
      svkorg_low  TYPE erpsls_billdoc-vkorg,
      svkorg_high TYPE erpsls_billdoc-vkorg,
      svtweg_low  TYPE erpsls_billdoc-vtweg,
      svtweg_high TYPE erpsls_billdoc-vtweg.

FIELD-SYMBOLS: <fs_data> LIKE LINE OF it_data.