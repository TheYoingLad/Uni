endmethod.


method set_function_code .
  _mo_logger->log_task_begin( task = 'SET_FUNCTION_CODE'
                              text = |API: C_UCOMM:{ C_UCOMM }| ).

  data: l_ucomm type sy-ucomm,
        lflg_save type c.

  call method transfer_fcode_slis_to_lvc
    exporting
      i_fcode_slis   = c_ucomm
    importing
      e_fcode_lvc    = l_ucomm
    exceptions
      no_match_found = 1.
  if sy-subrc ne 0.
    _mo_logger->log_task_end( task = 'SET_FUNCTION_CODE'
                              text = |API RAISE_EVENT: BEFORE_USER_COMAMND and EXIT| ).
    _raise_evt_before_user_command( c_ucomm ).
    exit.
  endif.

  clear c_ucomm.

  get_frontend_fieldcatalog( importing et_fieldcatalog = m_cl_variant->mt_fieldcatalog ).
  _macro_conditional_flush.

  data ls_stable type lvc_s_stbl.
  me->execute_fcode(  exporting i_ucomm        = l_ucomm
                      importing
                        e_stable_col   = ls_stable-col
                        e_stable_row   = ls_stable-row
                        e_refresh_mode = data(lv_refresh_mode)
                        e_save         = lflg_save ).
  if lflg_save = 'X'.
    c_ucomm = mc_fc_data_save.
  endif.

  _refresh_grid_wo_autoredraw( refresh_mode = lv_refresh_mode s_stable = ls_stable s_info = value #( ) ).

  _mo_logger->log_task_end( task = 'SET_FUNCTION_CODE'
                            text = |API: C_UCOMM:{ C_UCOMM } ls_stable(see data): |
                            data = ls_stable ).
endmethod.                    "set_function_code


method set_graphics_container.

  mr_graphics_container = i_graphics_container.

endmethod.


method set_gridtitle.

* ...
