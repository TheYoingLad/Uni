METHOD get_frontend_fieldcatalog.
  et_fieldcatalog = m_cl_variant->mt_fieldcatalog.

  CHECK m_invalid_frontend_fieldcat IS INITIAL.
  CHECK m_batch_mode IS INITIAL.

  CALL METHOD me->get_col_pos_id_base
    IMPORTING  col_pos_table = mt_col_pos_id_table
    exceptions error         = 0.   "Is not relevant...

  _mo_logger->log_task_begin( task = 'GET_FRONTEND_FIELDCATALOG'
                              text = |MT_COL_POS_ID_TABLE(see data):|
                              data = mt_col_pos_id_table ).

  IF m_dp_on_demand_writable IS INITIAL.
    _macro_flush.
  ENDIF.

  LOOP AT et_fieldcatalog ASSIGNING FIELD-SYMBOL(<ls_fcat>).
    IF <ls_fcat>-no_out EQ 'X'.
      READ TABLE mt_col_pos_id_table INTO data(ls_col_pos_id)
        WITH KEY col_id-fieldname = <ls_fcat>-fieldname.
      IF sy-subrc EQ 0.
        <ls_fcat>-no_out    = space.
        <ls_fcat>-col_pos   = ls_col_pos_id-col_pos.
        <ls_fcat>-outputlen = ls_col_pos_id-outputlen.
        IF <ls_fcat>-outputlen EQ 0.
          <ls_fcat>-outputlen = 1.
        ENDIF.
      ENDIF.
    ELSE.
      READ TABLE mt_col_pos_id_table INTO ls_col_pos_id
        WITH KEY col_id-fieldname = <ls_fcat>-fieldname.
      IF sy-subrc NE 0.
        <ls_fcat>-no_out = 'X'.
      ELSE.
        <ls_fcat>-outputlen = ls_col_pos_id-outputlen.
        <ls_fcat>-col_pos   = ls_col_pos_id-col_pos.
        IF <ls_fcat>-outputlen EQ 0.
          <ls_fcat>-outputlen = 1.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDLOOP.
  _mo_logger->log_task_end( task = 'GET_FRONTEND_FIELDCATALOG'
                            data = et_fieldcatalog ).
ENDMETHOD.


