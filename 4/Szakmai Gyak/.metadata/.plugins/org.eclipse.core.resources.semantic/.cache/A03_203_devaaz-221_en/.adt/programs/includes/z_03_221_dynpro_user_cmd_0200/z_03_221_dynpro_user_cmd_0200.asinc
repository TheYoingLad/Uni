*----------------------------------------------------------------------*
***INCLUDE Z_03_221_DYNPRO_USER_CMD_0200.
*----------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_0200  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE user_command_0200 INPUT.

  CASE ok_code.
    WHEN 'LEAVE'.
      LEAVE PROGRAM.
    WHEN 'BACK'.
    WHEN 'SAVE'.
      IF spfli <> wa_flight.
        MODIFY spfli FROM spfli.
      ENDIF.
  ENDCASE.

ENDMODULE.