MODULE submit_0100 INPUT.

  DATA: lt_tfill  TYPE sytfill,
        lt_data   TYPE STANDARD TABLE OF abaplist,
        lt_string TYPE string,
        lt_trash  TYPE string,
        lt_ascii  TYPE TABLE OF char255.

  FIELD-SYMBOLS: <data> TYPE mytable,
                 <line> type string.

  CASE ok_code.
    WHEN 'BACK'.
      LEAVE PROGRAM.
    WHEN 'SEARCH'.
      SUBMIT erpsls_billdoc_view
      WITH svbeln IN svbeln
      WITH sfkart IN sfkart
      WITH sfkdat IN sfkdat
      WITH svkorg IN svkorg
      WITH svtweg IN svtweg
      WITH popen = gv_open
      WITH pnotopen = gv_not_open
      AND RETURN
      EXPORTING LIST TO MEMORY.
  ENDCASE.

  CLEAR lt_data.
  CALL FUNCTION 'LIST_FROM_MEMORY'
    TABLES
      listobject = lt_data
    EXCEPTIONS
      not_found  = 1.

  IF sy-subrc = 1.
    MESSAGE s490(vr).
    RETURN.
  ENDIF.

  CLEAR lt_ascii.
  CALL FUNCTION 'LIST_TO_ASCI'
    TABLES
      listobject = lt_data
      listasci   = lt_ascii.

  DELETE lt_ascii INDEX 1.
  DELETE lt_ascii INDEX 1.
  DELETE lt_ascii INDEX 1.

  lt_tfill = lines( lt_ascii ).

  DELETE lt_ascii INDEX lt_tfill.

  CLEAR it_mytable.
  LOOP AT lt_ascii INTO lt_string.
    SPLIT lt_string AT '|' INTO
        lt_trash
        <data>-fkart
        lt_trash
        lt_trash
        <data>-fkdat
        <data>-vkorg
        <data>-vtweg
        lt_trash
        <data>-vbeln.

    APPEND <data> TO it_mytable.
  ENDLOOP.

  lt_tfill = 0. " dummy line for debugging

ENDMODULE.